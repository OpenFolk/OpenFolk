# OpenFolk backend (local/): settings of one machine that runs bots.
#
# Nothing here is required: `npm start` without a .env runs everything on this computer and generates every key on
# the first start (local/data/). Several machines share one relay of your own (relay/.env.sample, docs/running.md):
# set RELAY_URL on the first machine; every further one joins with "Add machine" in the app and
# `npm run join -- "<link>"`, which writes RELAY_URL, AGENT_TOKEN and E2E_KEY here. (By hand: `npm run env` on the
# first machine and copy this file.)
#
# Everything a paired device may change lives in the app's settings, not here: profile pictures and their API keys,
# voice messages, notifications, git, and per machine Claude's sign-in, the git token for pushing, shutting down and
# handing chats over.
#
#   KEY=         usually set            #KEY=value   optional, shows the default or an example
#   [all]        same on every machine  [machine]    differs per machine


# ---- 1. Relay ---------------------------------------------------------------------------------------------------

# [all] Your own relay, e.g. wss://openfolk.example.com/ws/agent. Empty: the backend runs one itself (section 4).
RELAY_URL=
# [all] Shared secret backend <-> relay, at least 16 characters. Empty: generated, handed to the relay it claims.
AGENT_TOKEN=
# Setup code from the log of a new relay: the backend claims it on its first connection (containers).
# By hand instead: npm run claim -- https://<relay> <code>
#RELAY_SETUP_CODE=
# Address of the web app in pairing links if it differs from the relay's (Tailscale, a proxy, a container)
#APP_URL=https://openfolk.example.com


# ---- 2. Keys ----------------------------------------------------------------------------------------------------

# [all] End-to-end key browsers <-> backends (32 bytes, base64), never on the relay host. Empty: generated.
# off: no encryption; the relay host can read every chat, and API keys from the app stay on their machine.
#E2E_KEY=
# [all] Web push key pair; empty: generated (`node local/tools/e2e.mjs vapid` writes it here)
#PUSH_VAPID_PUBLIC_KEY=
#PUSH_VAPID_PRIVATE_KEY=


# ---- 3. This machine --------------------------------------------------------------------------------------------

# [machine] Name for the relay and the app (default: computer name); must match the relay's wake settings
#MACHINE_NAME=
# [machine] Folders bots may be created in, separated by ; (default: the home folder)
#ALLOWED_ROOTS=
# [machine] Bots, chats and history (default: local/data)
#DATA_DIR=
# [machine] Python with faster-whisper for voice messages, only for an environment of your own (default: the one
# "Set up voice messages" in the app creates, or local/tools/.venv)
#WHISPER_PYTHON=


# ---- 4. Only without RELAY_URL: the relay inside this backend ---------------------------------------------------
# With a relay of your own these are ignored; they belong to the relay (relay/.env.sample).

# Port and listen address; 0.0.0.0 only behind a reverse proxy with a certificate (other devices: docs/tailscale.md)
#RELAY_PORT=8787
#RELAY_LISTEN=127.0.0.1
# Password of the web app, needed only without a pairing link; empty: generated (node local/tools/e2e.mjs password)
#USER_PASSWORD=
# Waking machines for routines: WAKE_METHOD, WAKEUP_URL, WAKEUP_API_TOKEN, WAKE_MACHINES … as in relay/.env.sample
# 0: do not open the browser with the pairing link on the first start
#OPEN_BROWSER=1


# ---- 5. Engines (only if not found by themselves) ---------------------------------------------------------------
# Claude needs nothing here. Codex and Copilot come as optional npm dependencies (about 600 MB; leave them out with
# `npm install --omit=optional`). Each engine needs its own login.

#CODEX_BIN=
# default %LOCALAPPDATA%\cursor-agent; login: agent login
#CURSOR_AGENT_DIR=
# login: npx copilot login
#COPILOT_BIN=
# default %LOCALAPPDATA%\antigravity-acp; install: node local/tools/acp-install.mjs antigravity-acp
#ANTIGRAVITY_ACP_DIR=
# free models without login (providers may train on the data); others: npx opencode auth login
#OPENCODE_BIN=


# ---- 6. Shutting down and automatic sign-in [machine] -----------------------------------------------------------
# How this machine shuts down; whether the app may, and when, is set in the app. Without script or command: the
# system's shutdown command (macOS/Linux need the right to; never in a container).

# PHP script with --in=<seconds>, --abbrechen, --neustart, --wenn-frei, --json; answers {ok, um} or {error}
#SHUTDOWN_SCRIPT=
#PHP_BIN=php
# Or own commands ({seconds}, {minutes}); without a restart command the app offers no restart
#SHUTDOWN_COMMAND=sudo shutdown -h +{minutes}
#SHUTDOWN_CANCEL_COMMAND=sudo shutdown -c
#SHUTDOWN_RESTART_COMMAND=sudo shutdown -r +{minutes}
# Own check "nobody uses the machine" (exit code 0 = free); default: signed-in sessions with recent input
#MACHINE_IDLE_COMMAND=
# Automatic Windows sign-in: PowerShell script with -Json, -An, -Aus (answers {ok, an, kennwort}); switched in the app
#AUTOLOGON_SCRIPT=
# script or none (default: script if AUTOLOGON_SCRIPT is set, on Windows)
#AUTOLOGON_METHOD=


# ---- 7. Handing a chat over ("Open in the IDE" / "in a terminal") [machine] -------------------------------------
# Own command with {folder}, {session} and {claude}; on or off in the app. Defaults: VS Code, a terminal with
# `{claude} --resume {session}`.

#HANDOVER_IDE=cursor "{folder}" && start "" "cursor://anthropic.claude-code/open?session={session}"
#HANDOVER_TERMINAL=wt -d "{folder}" "{claude}" --resume {session}


# ---- 8. Push to the mobile apps (only if you build the apps yourself, mobile/README.md) -------------------------

# iOS: APNs key (.p8) with key id and team id; APNS_TOPIC only if the app reports no bundle id
#APNS_KEY_FILE=
#APNS_KEY_ID=
#APNS_TEAM_ID=
#APNS_TOPIC=io.openfolk.app
# auto (production, sandbox for development builds), production or sandbox
#APNS_ENV=auto
# Android: JSON key of a Firebase service account
#FCM_SERVICE_ACCOUNT_FILE=
