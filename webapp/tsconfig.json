{
    // Type check of the web app (plain JavaScript with JSDoc, no build): npm run typecheck
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": false,
        "skipLibCheck": true,
        "types": []
    },
    "include": ["js/**/*.js", "i18n/**/*.js", "types/**/*.d.ts"]
}
