# Relay (relay/): on the relay host. In a container these are the application's variables (Docker Compose reads
# them from a .env next to docker-compose.yml); for `npm run relay` they go into relay/.env.
# Nothing from the backend's .env belongs here: the relay never needs E2E_KEY, the push keys or git tokens.

# ==== Owner: the two tokens, or neither ====
# Without both the relay starts unclaimed: it prints a setup code to its log, and the backend that sends that code
# (npm run claim -- https://<relay> <code>, or RELAY_SETUP_CODE in its .env) owns the relay; it keeps only hashes
# (owner.json in RELAY_DATA). Set both to choose the values yourself; they win over a claim.
# Password for the web app's login, needed only without a pairing link; at least 16 characters
# (create: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
USER_PASSWORD=
# Shared secret backend <-> relay, at least 16 characters, the same value as AGENT_TOKEN in the backends' .env
AGENT_TOKEN=
# Setup code of an unclaimed relay (at least 10 letters and digits); empty: a new one on every start, in the log
#RELAY_SETUP_CODE=

# ==== Optional: everything below has a working default ====

# The second factor is set up in the app (Settings, Devices and security) and kept in totp.json in RELAY_DATA.
# A TOTP_SECRET from before is taken over once into that file; afterwards it is ignored and can go.
# Port of the relay (the reverse proxy forwards to it)
#RELAY_PORT=8787
# Reverse proxies in front of the relay whose X-Forwarded-For counts for the login throttle and AGENT_ALLOWED_FROM.
# Empty (auto): one proxy, but only if it connects from a private or loopback address (Docker network, Coolify,
# nginx on the same host); a relay reachable straight from the internet ignores the header. A number: that many
# proxies (2 e.g. for a CDN in front of the proxy), 0: never.
#TRUST_PROXY=
# Interval of the pings to browsers and backends in ms; without a pong until the next ping the connection is closed
#HEARTBEAT_MS=30000
# Storage of the signed-in devices (in the container e.g. /data on a volume; locally relay/data)
#RELAY_DATA=
# Only allow backends via a VPN such as Tailscale (IP/CIDR, comma-separated), e.g. 100.64.0.0/10
#AGENT_ALLOWED_FROM=
# ---- Waking machines. WAKE_METHOD:
#   service  external wake service: GET <WAKEUP_URL>/api.php -> {hosts: {<name>: {active}}, at}, POST {host} wakes;
#            knows whether a machine is running
#   wol      Wake-on-LAN magic packet straight from the relay (relay in the same network or a forwarded UDP port)
#   command  own command with {machine} and {mac}, e.g. ssh to the router or a call to a home automation system
#   none     no waking
# Default: service if WAKEUP_URL is set, command if WAKE_COMMAND is set, wol if WAKE_MACHINES has MAC addresses.
#WAKE_METHOD=
# service: address and API token (at least 32 characters) of the wake service
#WAKEUP_URL=
#WAKEUP_API_TOKEN=
# wol/command: wakeable machines as name=MAC (names as MACHINE_NAME of the backends; MAC optional with command)
#WAKE_MACHINES=desktop=AA:BB:CC:DD:EE:FF,laptop=11:22:33:44:55:66
# wol: target (broadcast address of the network, or a router address with port forwarding) and UDP port
#WOL_ADDRESS=255.255.255.255
#WOL_PORT=9
#WAKE_COMMAND=ssh root@router etherwake -i br-lan {mac}
# Routines with "wake": wake this many seconds before the due time; still wake up to this long after it
#WAKE_LEAD_SECONDS=180
#WAKE_GRACE_SECONDS=300
# Push to the mobile apps for backends without credentials of their own: APNS_KEY with the contents of the .p8
# file, APNS_KEY_ID, APNS_TEAM_ID, APNS_TOPIC, APNS_ENV as in the backend's .env.sample, and FCM_SERVICE_ACCOUNT
# with the JSON of the Firebase service account. The relay then sees the preview of those notifications
# (docs/internals/push.md).
#APNS_KEY=
#APNS_KEY_ID=
#APNS_TEAM_ID=
#APNS_TOPIC=
#APNS_ENV=
#FCM_SERVICE_ACCOUNT=
